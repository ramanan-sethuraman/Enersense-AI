# ========================================================
# Enersense AI – Environment Variables Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# MongoDB connection string (e.g. mongodb://localhost:27017/enersense or Atlas URI).
# If MongoDB is not reachable, Enersense AI automatically falls back to an embedded
# JSON persistence store so the app works seamlessly out-of-the-box!
MONGO_URI=mongodb://localhost:27017/enersense

# Authentication Secrets
JWT_SECRET=enersense_ai_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# OCR Configuration
# Supported providers: google_vision, tesseract (built-in local worker, 100% free offline fallback)
# Google Cloud Vision Free Tier gives 1,000 text detection requests per month 100% FREE!
# If GOOGLE_VISION_API_KEY is left blank, the app seamlessly runs using the local OCR engine.
OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=

# AI Advisor Configuration
# Supported: gemini, openai, rule_based (built-in default when API key is blank)
AI_PROVIDER=gemini
AI_API_KEY=
